# Open Dungeon Raid — public tree ignores (generated / local-only / never distribute)
# Build outputs (regenerated by rebuild/web/build.sh — dr.js is COMMITTED as the wasm build;
# the html targets are regenerated on every build)
rebuild/web/demo.html
rebuild/web/demo_art.html
rebuild/web/demo_art_hd.html
rebuild/drcli
rebuild/drcli.exe

# Local-only game assets: private fonts and any atlas regenerated from them.
# (The shipped assets/ripped-hd/font*.png are the AnimeSharp versions; a local
#  tools/hd/regen_fonts.py run with MOOLBOR.TTF would overwrite them — do NOT commit
#  those overwrites: `git checkout -- assets/ripped-hd/font*.png` restores the shipped ones.)
assets/fonts-private/
assets/ripped-hd/regen_fonts_report.json
# tools/setup_assets.sh regen keeps a *_ai.png copy of the shipped HD font atlases locally
assets/ripped-hd/*_ai.png

# dist/ = make_final.sh output (per-build folders + APKs, never committed)
dist/

# build_apk.sh writes its gradle/signing logs under tasks/U2 and tasks/U4b
/tasks/

# Android build outputs (android/app/src/main/res/mipmap-* ARE committed: the placeholder icon)
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/
android/*.apk
android/*.aab

# Python
__pycache__/
*.pyc
.venv/
.venv-hd/
venv/

# Pages site assembly (local mirror of the workflow step)
site/

# Editors / OS
.DS_Store
*.swp
